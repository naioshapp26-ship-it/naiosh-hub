# Naiosh Hub — Environment Variables (Railway / local)
# انسخ إلى Variables في خدمة naiosh-hub على Railway

# --- Required / Core ---
NODE_ENV=production
PORT=8080
APP_NAME=naiosh-hub

# من خدمة Postgres على Railway (Variable Reference):
# DATABASE_URL=${{Postgres.DATABASE_URL}}
# DATABASE_PRIVATE_URL=${{Postgres.DATABASE_PRIVATE_URL}}
DATABASE_URL=
DATABASE_PRIVATE_URL=

# --- Recommended ---
APP_URL=https://naiosh-hub-production.up.railway.app
CORS_ORIGIN=*
HUB_AUTO_MIGRATE=true
# Leave false/unset in production — do not seed demo clients or allow legacy demo logins
HUB_ALLOW_LEGACY_DEMO=
HUB_DEMO_AUTH=
SESSION_SECRET=change-me-to-a-long-random-string

# Production Super Admin bootstrap (set once, then unset). Never commit the real value.
# HUB_SUPER_ADMIN_EMAIL=naioshhub@example.com
# HUB_SUPER_ADMIN_INITIAL_PASSWORD=
# Ops recovery only: set to 1 with INITIAL_PASSWORD to re-hash Super Admin on boot, then unset.
# HUB_SUPER_ADMIN_FORCE_PASSWORD_RESET=
# Optional absolute floor only (default 1 = any non-empty password; no complexity rules)
# HUB_PASSWORD_MIN_LENGTH=1
# HUB_LOGIN_RATE_MAX=12
# HUB_EXPOSE_RESET_TOKEN=1   # staging only — expose reset token when SMTP unset
# HUB_LEGACY_DEMO_PASSWORD=  # only with HUB_ALLOW_LEGACY_DEMO=1 for local E2E
# Limited E2E staff (does NOT reset Super Admin). Defaults email: e2e-branches@naiosh.test
# HUB_E2E_STAFF_EMAIL=e2e-branches@naiosh.test
# HUB_E2E_STAFF_PASSWORD=   # or falls back to HUB_SUPER_ADMIN_INITIAL_PASSWORD for this test identity only

# Optional
# PGSSLMODE=require

# Google Maps (optional — without these, free-text branch entry still works; map UI shows disabled)
# Browser key: restrict by HTTP referrer in Google Cloud Console
# GOOGLE_MAPS_BROWSER_KEY=
# Server key: restrict by IP; used only via /api/hub/geo/* proxy (never sent to browser)
# GOOGLE_MAPS_SERVER_KEY=
# Or a single key for both (less ideal):
# GOOGLE_MAPS_API_KEY=
