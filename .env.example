# Naiosh Hub — Environment Variables (Railway / local)
# انسخ إلى Variables في خدمة naiosh-hub على Railway

# --- Required / Core ---
NODE_ENV=production
PORT=8080
APP_NAME=naiosh-hub

# من خدمة Postgres على Railway (Variable Reference):
# DATABASE_URL=${{Postgres.DATABASE_URL}}
# DATABASE_PRIVATE_URL=${{Postgres.DATABASE_PRIVATE_URL}}
DATABASE_URL=
DATABASE_PRIVATE_URL=

# --- Recommended ---
APP_URL=https://naiosh-hub-production.up.railway.app
CORS_ORIGIN=*
HUB_AUTO_MIGRATE=true
HUB_DEMO_AUTH=true
SESSION_SECRET=change-me-to-a-long-random-string

# Optional
# PGSSLMODE=require
